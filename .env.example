SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_backend_secret
SUPABASE_DB_PASSWORD=replace_with_your_database_password
SUPABASE_ACCESS_TOKEN=replace_with_your_personal_access_token

# AI provider settings
AURA_AI_BASE_URL=https://your-ai-gateway.example/v1
AURA_AI_API_KEY=replace_with_your_ai_gateway_key
AURA_AI_TIMEOUT_SECONDS=45
AURA_VISION_MODEL=gemini-3.5-flash-lite
AURA_EMBEDDING_MODEL=text-embedding-3-small
AURA_EMBEDDING_DIMENSIONS=1536
AURA_MAX_IMAGE_BYTES=10485760
AURA_MIN_IMAGE_DIMENSION=256

# Optional OpenAI reference-image generation for /suggestion
OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_API_KEY=replace_with_your_openai_platform_key
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_TIMEOUT_SECONDS=300
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_SIZE=1024x1024

# Telegram frontend settings
TELEGRAM_BOT_TOKEN=replace_with_your_botfather_token
AURA_BACKEND_URL=http://127.0.0.1:8000
AURA_BACKEND_TIMEOUT_SECONDS=120

# Optional public landing-page button destination; configure on the backend only
AURA_PUBLIC_TELEGRAM_URL=https://t.me/replace_with_your_bot_username

# Shared only by the Telegram worker and backend; use at least 32 random characters
AURA_INTERNAL_API_KEY=replace_with_a_long_random_shared_secret
