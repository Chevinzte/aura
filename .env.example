SUPABASE_SECRET_KEY=sb_secret_replace_with_your_backend_secret
SUPABASE_DB_PASSWORD=replace_with_your_database_password
SUPABASE_ACCESS_TOKEN=replace_with_your_personal_access_token

# AI provider settings
AURA_AI_BASE_URL=https://your-ai-gateway.example/v1
AURA_AI_API_KEY=replace_with_your_ai_gateway_key
AURA_AI_TIMEOUT_SECONDS=45
AURA_VISION_MODEL=gemini-3.5-flash-lite
